# Copy this file to .env and adjust values

# Port the local server listens on
PORT=3000

# Base URL your tablets will use to reach this backend.
# For local testing this can stay as http://localhost:3000
# For a real pilot, this must be an HTTPS URL Headwind/FreeKiosk will use in CUSTOM3.
BASE_URL=http://localhost:3000

# Path to the SQLite database file
DB_PATH=./data/kiosk.db
